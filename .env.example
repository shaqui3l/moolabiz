# ─── Anthropic Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Lelapa AI (VulaVula) ───────────────────────────────────────────────────
# For MVP cost control, you can switch to an OpenAI-compatible endpoint
# (e.g. Azure OpenAI / GitHub Models) with LANGUAGE_AI_PROVIDER=openai_compatible.
LANGUAGE_AI_PROVIDER=lelapa
LELAPA_API_KEY=your-lelapa-api-key
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=a-random-secret-you-choose

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Cron security ──────────────────────────────────────────────────────────
CRON_SECRET=a-random-secret-for-cron-routes

# ─── Admin dashboard ────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme

# ─── Devil's Advocate ───────────────────────────────────────────────────────
ADVOCATE_API_KEY=your-secret-key-here

# ─── Yoco (South Africa) ────────────────────────────────────────────────────
YOCO_SECRET_KEY=sk_live_...
YOCO_WEBHOOK_SECRET=whsec_...

# ─── Ozow (South Africa – Instant EFT) ─────────────────────────────────────
OZOW_SITE_CODE=your-site-code
OZOW_API_KEY=your-api-key
OZOW_PRIVATE_KEY=your-private-key

# ─── PayFast (South Africa) ─────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true

# ─── Payments general ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
PAYMENTS_API_KEY=your-secret-key-here
